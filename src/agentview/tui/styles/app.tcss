Screen {
    background: $background;
}

#three-zone {
    layout: horizontal;
    height: 1fr;
}

#sidebar {
    width: 28;
    border-right: solid $primary;
    padding: 0 1;
}

#main-panel {
    width: 1fr;
    border-right: solid $primary;
    padding: 0 1;
}

#detail-pane {
    width: 2fr;
    padding: 0 1;
}

.zone-title {
    text-style: bold;
    color: $primary;
    padding-bottom: 1;
}

#category-list,
#item-list {
    height: 1fr;
    background: $surface;
}

#detail-body {
    height: auto;
    layout: vertical;
}

#detail-body .detail-header {
    padding-bottom: 1;
}

#detail-body .scope-tag {
    padding-bottom: 1;
}

#detail-body .muted {
    color: $text-muted;
}

/* Card pattern — borrowed from Posting's `.section`. Rounded border at
   40% accent alpha so cards anchor sections without overpowering the
   theme; `:focus-within` thickens to full alpha. */
#detail-body .section-card {
    height: auto;
    border: round $accent 40%;
    border-title-color: $text-accent 60%;
    padding: 0 1;
    margin-bottom: 1;
}

#detail-body .section-card:focus-within {
    border: round $accent;
    border-title-style: bold;
    border-title-color: $text-accent;
}

#detail-body .section-card.severity-error {
    border: round $error;
    border-title-color: $error;
}

#detail-body .section-card.severity-warning {
    border: round $warning;
    border-title-color: $warning;
}

#detail-body .section-card.severity-info {
    border: round $primary;
    border-title-color: $primary;
}

#detail-body DataTable {
    height: auto;
    max-height: 12;
}

#detail-body Markdown {
    background: $surface;
}

Header {
    dock: top;
}

Footer {
    dock: bottom;
}
