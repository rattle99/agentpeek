Screen {
    background: $background;
}

#three-zone {
    layout: horizontal;
    height: 1fr;
}

#sidebar {
    width: 28;
    border-right: solid $primary;
    padding: 0 1;
}

#main-panel {
    width: 1fr;
    border-right: solid $primary;
    padding: 0 1;
}

#detail-pane {
    width: 2fr;
    padding: 0 1;
}

.zone-title {
    text-style: bold;
    color: $primary;
    padding-bottom: 1;
}

#category-list,
#item-list {
    height: 1fr;
    background: $surface;
}

#detail-body {
    height: auto;
    layout: vertical;
}

#detail-body .detail-header {
    padding-bottom: 1;
}

#detail-body .scope-tag {
    padding-bottom: 1;
}

#detail-body .section-title {
    color: $primary;
    text-style: bold;
    padding-top: 1;
}

#detail-body .muted {
    color: $text-muted;
}

#detail-body DataTable {
    margin-top: 1;
    height: auto;
    max-height: 12;
}

#detail-body Markdown {
    margin-top: 1;
    background: $surface;
}

#detail-body Rule {
    margin: 0;
    color: $primary 50%;
}

Header {
    dock: top;
}

Footer {
    dock: bottom;
}
