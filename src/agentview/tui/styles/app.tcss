Screen {
    background: $background;
}

#three-zone {
    layout: horizontal;
    height: 1fr;
}

#sidebar {
    width: 28;
    border-right: solid $primary;
    padding: 0 1;
}

#main-panel {
    width: 1fr;
    border-right: solid $primary;
    padding: 0 1;
}

#detail-pane {
    width: 2fr;
    padding: 0 1;
}

.zone-title {
    text-style: bold;
    color: $primary;
    padding-bottom: 1;
}

#category-list,
#item-list {
    height: 1fr;
    background: $surface;
}

#detail-content {
    height: auto;
    color: $text;
}

Header {
    dock: top;
}

Footer {
    dock: bottom;
}
