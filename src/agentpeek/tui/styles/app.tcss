Screen {
    background: $background;
}

#three-zone {
    layout: horizontal;
    height: 1fr;
}

#sidebar {
    width: 28;
    background: $surface 70%;
    border-right: solid $primary 60%;
    padding: 1 1;
}

#main-panel {
    width: 1fr;
    background: $surface 40%;
    border-right: solid $primary 60%;
    padding: 1 1;
}

#detail-pane {
    width: 2fr;
    background: $surface 15%;
    padding: 1 2;
}

.zone-title {
    text-style: bold;
    color: $primary;
    padding-bottom: 1;
}

#category-list,
#item-list {
    height: 1fr;
    background: transparent;
}

#filter-input {
    height: 3;
    margin-bottom: 1;
    border: round $accent 40%;
}

#filter-input:focus {
    border: round $accent;
}

/* Sidebar two-column row — name expands, count chip stays auto-sized
   on the right. */
#category-list Horizontal {
    height: auto;
    width: 1fr;
}

#category-list .sidebar-name {
    width: 1fr;
}

#category-list .sidebar-count {
    width: auto;
    color: $text-muted;
}

/* Breathing room — horizontal padding inside each row plus a quiet
   hkey divider so consecutive rows visually separate without forcing
   tall rows. */
#category-list > ListItem,
#item-list > ListItem {
    padding: 0 1;
    border-bottom: hkey $surface 20%;
}

#category-list > ListItem:last-child,
#item-list > ListItem:last-child {
    border-bottom: none;
}

/* Group headers in the items list — non-selectable plugin dividers
   used by the Skills category. Distinct background + accent left
   border + dimmed text-style on hover-attempt make it clear these
   aren't clickable rows. */
#item-list > ListItem.group-header {
    background: $primary 15%;
    border-left: thick $primary;
    padding-top: 1;
}

/* Even when highlighted (cursor passes over a header) keep the
   visual identical — disabled+highlighted shouldn't look selectable.
   NB: Textual's highlight state class is `-highlight` (single dash);
   the `--`-prefixed form parses as a CSS-variable selector and matches
   nothing. */
#item-list > ListItem.group-header.-highlight,
#item-list:focus > ListItem.group-header.-highlight {
    background: $primary 15%;
    text-style: none;
}

/* Selection emphasis — override Textual's default focused-row styling
   (which uses `$block-cursor-background` = `$primary` blue) with the
   theme's accent tint. Without this override, the row turns the same
   blue as the `[U]` scope marker and the marker disappears. */
ListView > ListItem.-highlight {
    background: $accent 25%;
}

ListView:focus > ListItem.-highlight {
    background: $accent 50%;
    text-style: bold;
}

#detail-body {
    height: auto;
    layout: vertical;
}

/* Per-item hero header — bottom rule anchors the title against the
   cards below. */
#detail-body .detail-header {
    padding-bottom: 0;
    margin-bottom: 1;
    border-bottom: hkey $accent 30%;
}

/* Scope tag becomes a compact chip alongside the title rather than a
   full-width label-block. Auto width so it hugs its content. */
#detail-body .scope-tag {
    width: auto;
    padding: 0 1;
    margin-bottom: 1;
    background: $primary 20%;
    color: $primary;
}

#detail-body .muted {
    color: $text-muted;
}

/* Card pattern — borrowed from Posting's `.section`. Rounded border at
   40% accent alpha so cards anchor sections without overpowering the
   theme; `:focus-within` thickens to full alpha. */
#detail-body .section-card {
    height: auto;
    background: $surface;
    border: round $accent 40%;
    border-title-color: $text-accent 60%;
    padding: 0 2;
    margin-bottom: 1;
}

#detail-body .section-card:focus-within {
    border: round $accent;
    border-title-style: bold;
    border-title-color: $text-accent;
}

#detail-body .section-card.severity-error {
    border: round $error;
    border-title-color: $error;
}

#detail-body .section-card.severity-warning {
    border: round $warning;
    border-title-color: $warning;
}

#detail-body .section-card.severity-info {
    border: round $primary;
    border-title-color: $primary;
}

#detail-body DataTable {
    height: auto;
    max-height: 12;
}

#detail-body Markdown {
    background: $surface;
}

Header {
    dock: top;
}

Footer {
    dock: bottom;
}

/* Help modal — centered card on a dimmed backdrop. */
HelpScreen {
    align: center middle;
    background: $background 60%;
}

HelpScreen > #help-card {
    width: 60;
    height: auto;
    max-height: 24;
    background: $surface;
    border: round $accent;
    padding: 1 2;
}

HelpScreen #help-title {
    text-style: bold;
    color: $primary;
    padding-bottom: 1;
}

HelpScreen #help-bindings {
    height: auto;
    max-height: 18;
    background: $surface;
}

/* Skill detail modal — popped when Enter is pressed on a row of the
   plugin-detail Skills card. Larger than HelpScreen because it shows
   the full SKILL.md body. */
SkillDetailModal {
    align: center middle;
    background: $background 60%;
}

SkillDetailModal > #skill-modal-card {
    width: 80%;
    height: 80%;
    background: $surface;
    border: round $accent;
    padding: 1 2;
}

SkillDetailModal #skill-modal-title {
    text-style: bold;
}

SkillDetailModal #skill-modal-source {
    padding-bottom: 1;
}

SkillDetailModal #skill-modal-desc {
    padding-bottom: 1;
}

SkillDetailModal #skill-modal-body {
    height: 1fr;
    background: $surface;
}

/* Agent detail modal — mirrors SkillDetailModal layout, popped when
   Enter is pressed on a row of the plugin-detail Agents card. */
AgentDetailModal {
    align: center middle;
    background: $background 60%;
}

AgentDetailModal > #agent-modal-card {
    width: 80%;
    height: 80%;
    background: $surface;
    border: round $accent;
    padding: 1 2;
}

AgentDetailModal #agent-modal-title {
    text-style: bold;
}

AgentDetailModal #agent-modal-source {
    padding-bottom: 1;
}

AgentDetailModal #agent-modal-desc {
    padding-bottom: 1;
}

AgentDetailModal #agent-modal-body {
    height: 1fr;
    background: $surface;
}
